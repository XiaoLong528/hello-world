# Multi-stage Dockerfile: UBI minimal runtime
# Stage 1: build
FROM registry.access.redhat.com/ubi8/ubi:latest AS builder
# Use dnf in the full UBI image to install build tools
RUN dnf -y install gcc make glibc-devel libcurl-devel zlib-devel && dnf clean all

WORKDIR /src
COPY . /src
RUN mkdir -p /src/bin && \
    gcc -O2 -Wall src/http_fetch.c -o /src/bin/http_fetch -lcurl -lz

# Stage 2: minimal runtime (Red Hat UBI minimal)
FROM registry.access.redhat.com/ubi8/ubi-minimal:latest
RUN microdnf install -y ca-certificates libcurl zlib && microdnf clean all
COPY --from=builder /src/bin/http_fetch /usr/local/bin/http_fetch
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/http_fetch"]